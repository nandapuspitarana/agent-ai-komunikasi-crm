DATABASE_URL="postgresql://user:pass@localhost:5444/crm?schema=public"
REDIS_URL="redis://localhost:5448"
REDIS_PREFIX="crm_agent:"
AES_ENCRYPTION_KEY="your-32-character-encryption-key"

# NextAuth Configuration
# Generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
# Generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET="your-secret-key-change-this-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:8201"
NEXT_PUBLIC_BASE_URL="http://localhost:8201"
AUTH_TRUST_HOST=true


# AI Agent Proxy (ai-agent-proxy/) – running on port 8200
AGENT_PROXY_URL="http://127.0.0.1:8200"
# Shared secret sent as X-Internal-Key on every call to the AI proxy.
# Must equal INTERNAL_API_KEY in the proxy's .env (the proxy rejects calls without it).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AGENT_PROXY_API_KEY=""

# Bearer secret for GET /api/cron/visitor-retention (endpoint is closed when empty).
CRON_SECRET=""

# HMAC secret for widget visitor tokens (defaults to AUTH_SECRET when empty).
WIDGET_TOKEN_SECRET=""
# Temporary bridge for old SDK builds that restore chat history with only tenantId+contactId.
# Leave false: when true, anyone who can guess a contactId can read that visitor's chat.
WIDGET_LEGACY_CONTACT_LOOKUP=false

# Supabase project JWT secret (Dashboard -> Project Settings -> API -> JWT Secret).
# Server-only: signs short-lived realtime tokens for the inbox and widget.
# NEVER prefix with NEXT_PUBLIC_.
SUPABASE_JWT_SECRET=""

# Optional: Local GPU LLM endpoint (leave empty if not using local GPU)
LOCAL_LLM_URL=""
LOCAL_LLM_TYPE="generic"

