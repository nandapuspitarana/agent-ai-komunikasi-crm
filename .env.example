DATABASE_URL="postgresql://user:pass@localhost:5444/crm?schema=public"
REDIS_URL="redis://localhost:5448"
REDIS_PREFIX="crm_agent:"
AES_ENCRYPTION_KEY="your-32-character-encryption-key"

# NextAuth Configuration
# Generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
# Generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET="your-secret-key-change-this-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:8201"
NEXT_PUBLIC_BASE_URL="http://localhost:8201"
AUTH_TRUST_HOST=true


# AI Agent Proxy (ai-agent-proxy/) – running on port 8200
AGENT_PROXY_URL="http://127.0.0.1:8200"

# Optional: Local GPU LLM endpoint (leave empty if not using local GPU)
LOCAL_LLM_URL=""
LOCAL_LLM_TYPE="generic"

