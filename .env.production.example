# =============================================================================
# Next.js CRM — Production Environment Configuration
# Copy this file to .env.production on the production server.
# NEVER commit the actual .env.production to version control.
# =============================================================================

# ── Deployment Versions ──────────────────────────────────────────────────────
# Specify service versions for updates and rollback capabilities
CRM_VERSION=1.0.0

# Database Connection
# Points to the 'postgres' service container defined in docker-compose.yml
DATABASE_URL="postgresql://user:pass@postgres:5432/crm?schema=public"

# Redis Connection
# Points to the 'redis' service container defined in docker-compose.yml
REDIS_URL="redis://redis:6379"

# Encryption Key for sensitive fields
# WARNING: Must be a unique, secure 32-character string
AES_ENCRYPTION_KEY="change-me-to-a-secure-32-char-key"

# NextAuth Configuration
# Generate a secure secret with: openssl rand -base64 32
AUTH_SECRET="change-this-in-production-must-be-min-32-chars-long"
NEXTAUTH_URL="https://your-crm-production-domain.com"
NEXT_PUBLIC_BASE_URL="https://your-crm-production-domain.com"
AUTH_TRUST_HOST=true


# External Agent Proxy Connection
# Points to the container host 'ai-agent-proxy' if deployed in the same Docker network
# or to the public URL of the standalone proxy server.
AGENT_PROXY_URL="http://ai-agent-proxy:8000"
