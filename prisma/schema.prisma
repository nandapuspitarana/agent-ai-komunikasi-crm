generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  subscription String        @default("free")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  integrations Integration[]
  flows        Flow[]
  chatSessions ChatSession[]
}

model Integration {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  provider String
  apiKey   String
  isActive Boolean @default(true)
}

model Flow {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  nodes     Json
  edges     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatSession {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  contactId String
  channel   String
  status    String    @default("bot")
  rating    Int?      // Rating from 1 to 5 given by user at the end
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id         String      @id @default(uuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id])
  senderType String
  content    String
  createdAt  DateTime    @default(now())
}
