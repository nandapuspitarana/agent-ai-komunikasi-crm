generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  AGENT
  BUSINESS_PARTNER
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_LOGIN
  USER_LOGOUT
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  ROLE_CHANGED
  STATUS_CHANGED
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  password          String
  name              String
  role              UserRole            @default(AGENT)
  tenantId          String?
  tenant            Tenant?             @relation("TenantUsers", fields: [tenantId], references: [id])
  tenantHandoffs    Tenant[]            @relation("TenantHandoffAgent")
  isActive          Boolean             @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  auditLogs         AuditLog[]          @relation("AuditLogUser")
  performedAudits   AuditLog[]          @relation("AuditLogPerformedBy")
  passwordResetTokens PasswordResetToken[]
}

model AuditLog {
  id            String      @id @default(uuid())
  action        AuditAction
  userId        String?
  user          User?       @relation("AuditLogUser", fields: [userId], references: [id])
  performedById String?
  performedBy   User?       @relation("AuditLogPerformedBy", fields: [performedById], references: [id])
  entityType    String      // "User", "Tenant", etc.
  entityId      String?
  changes       Json?       // Store old and new values
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime    @default(now())
  
  @@index([userId])
  @@index([performedById])
  @@index([action])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  usedAt    DateTime?
  createdAt DateTime @default(now())
  
  @@index([token])
  @@index([userId])
}

model Tenant {
  id           String        @id @default(uuid())
  name         String
  subscription String        @default("free")
  aiEnabled    Boolean       @default(true)
  aiSystemPrompt String?
  handoffAgentId String?
  handoffAgent   User?         @relation("TenantHandoffAgent", fields: [handoffAgentId], references: [id])
  activeFlowId   String?
  activeFlow     Flow?         @relation("TenantActiveFlow", fields: [activeFlowId], references: [id])
  
  // Appearance Configuration
  themeBrandColor      String?       @default("#801517")
  themeUserBubbleColor String?       @default("#801517")
  themeBotBubbleColor  String?       @default("#ffffff")
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  users          User[]        @relation("TenantUsers")
  integrations   Integration[]
  flows          Flow[]        @relation("TenantFlows")
  chatSessions   ChatSession[]
}

model Integration {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  provider String
  apiKey   String
  isActive Boolean @default(true)
}

model Flow {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation("TenantFlows", fields: [tenantId], references: [id])
  activeForTenants Tenant[] @relation("TenantActiveFlow")
  name      String
  description String?
  config    Json     @default("{}")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  intents   Intent[]
  knowledgeDocs KnowledgeDocument[]

  @@index([tenantId])
}

model Intent {
  id               String   @id @default(uuid())
  flowId           String
  flow             Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  name             String
  trainingPhrases  String[]
  responseType     String   // "text", "options", "form", "card"
  response         String
  options          String?
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([flowId])
}

model ChatSession {
  id               String    @id @default(uuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  contactId        String
  channel          String
  status           String    @default("bot")
  rating           Int?      // Rating from 1 to 5 given by user at the end
  handoffRequested Boolean   @default(false)
  assignedAgentId  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  messages         Message[]
}

model Message {
  id         String      @id @default(uuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id])
  senderType String
  content    String
  createdAt  DateTime    @default(now())
}

model KnowledgeDocument {
  id          String   @id @default(uuid())
  flowId      String
  flow        Flow     @relation(fields: [flowId], references: [id], onDelete: Cascade)
  tenantId    String
  metaName    String
  description String?
  category    String?
  tags        String[]
  filename    String
  fileType    String
  status      String   @default("pending") // pending, ready, failed
  chunkCount  Int      @default(0)
  proxyDocId  String?  // ID from Python proxy/Supabase vector store
  errorMsg    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([flowId])
  @@index([tenantId])
}

